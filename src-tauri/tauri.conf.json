{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Backstage",
  "version": "0.1.0",
  "identifier": "local.cratedesk.app",
  "build": {
    "frontendDist": "loading"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "public.app-category.music",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "resources": {
      "../app.py": "server/app.py",
      "../serato_crates/*.py": "server/serato_crates/",
      "../static/": "server/static/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
